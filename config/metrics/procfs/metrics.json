{
  "document": {
    "confidential": false
  },
  "metrics": {
    "memory.total": {
      "description": "Total memory available in the system",
      "unit": "bytes",
      "value_type": "uint64",
      "metric_type": "value",
      "identifier": "unknown",
      "metric_groups": ["memory"],
      "formula": "value * 1024",
      "collection": {
        "protocol": "procfs",
        "field_type": "key_value",
        "relative_path": "meminfo",
        "field_name": "MemTotal",
        "raw_value_type": "uint64"
      }
    },
    "memory.used": {
      "description": "Total used memory",
      "unit": "bytes",
      "value_type": "uint64",
      "metric_type": "value",
      "identifier": "unknown",
      "metric_groups": ["memory"],
      "formula": "max(mem_total - mem_available, 0) * 1024",
      "collection": {
        "protocol": "procfs",
        "inputs": [
          {
            "name": "mem_total",
            "field_type": "key_value",
            "relative_path": "meminfo",
            "field_name": "MemTotal",
            "raw_value_type": "uint64"
          },
          {
            "name": "mem_available",
            "field_type": "key_value",
            "relative_path": "meminfo",
            "field_name": "MemAvailable",
            "raw_value_type": "uint64"
          }
        ]
      }
    },
    "memory.utilization": {
      "description": "Average memory utilization percentage",
      "unit": "percent",
      "value_type": "float64",
      "metric_type": "value",
      "identifier": "unknown",
      "metric_groups": ["memory"],
      "formula": "if(mem_total == 0, 0, max(mem_total - mem_available, 0) * 100 / mem_total)",
      "collection": {
        "protocol": "procfs",
        "inputs": [
          {
            "name": "mem_total",
            "field_type": "key_value",
            "relative_path": "meminfo",
            "field_name": "MemTotal",
            "raw_value_type": "uint64"
          },
          {
            "name": "mem_available",
            "field_type": "key_value",
            "relative_path": "meminfo",
            "field_name": "MemAvailable",
            "raw_value_type": "uint64"
          }
        ]
      }
    },
    "cpu.{cpu_index}.utilization": {
      "description": "Average {label} utilization percentage",
      "unit": "percent",
      "value_type": "float64",
      "metric_type": "value",
      "identifier": "unknown",
