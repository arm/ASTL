#ifndef INCLUDE_ATL_VERSION_H_
#define INCLUDE_ATL_VERSION_H_

#include <stdint.h>

#include "atl/atl_utils.h"

#if defined(__cplusplus)
extern "C" {
#endif

// clang-format off
#ifndef ATL_VERSION
#define ATL_VERSION @ATL_VERSION@
#endif

#define ATL_VERSION_STRING "@ATL_VERSION@"
#define ATL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ATL_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ATL_VERSION_MICRO @PROJECT_VERSION_PATCH@
// clang-format on

// Note: Do not add to or modify the version structure in future API versions
typedef struct atl_version {
  uint32_t _major;
  uint32_t _minor;
  uint32_t _micro;
} atl_version;

/**
 * @brief Returns the compiled version of Arm Telemetry Library
 *
 * @return c-string with compiled version of Arm Telemetry Library
 */
ATL_API const char *atlVersionString();

/**
 * @brief Returns the compiled version of Arm Telemetry Library
 *
 * @return atl_version struct with compiled version of Arm Telemetry Library
 */
ATL_API atl_version atlVersion();

#if defined(__cplusplus)
}
#endif

#endif // INCLUDE_ATL_VERSION_H_
