%% Group 3: Metric subsystem (placed under core visually)
namespace Metrics{

class CollectionOperations{
    operationsBeforeStart: vector~Operation~
    operationsAtStart: vector~Operation~
    operationsOnSample: vector~Operation~
    operationsAtStop: vector~Operation~
    samplingInterval: SamplingInterval
    requirements: CollectorCapability
}

class IMetricManager{
    <<Interface>>
    +GetMetricCount()
    +GetMetrics()
    +GetCollectionOperations(std::span~ITarget~, std::span~IMetric~) CollectionOperations
}

%% Operations generically represent a functor, or something with an operator()
%% Some implementation notes / examples may be added later
class Operation{
    <<Interface>>
    +Execute()
}

%% a strategy for sampling a counter/metric specific to a target
class ISamplerStrategy{
    <<Interface>>
    +Sample() Operation
}

class SamplerOperation{
    +ISampleDestination
    +Execute()
}

class MetricManager{
    +GetMetricCount()
    +GetMetrics()
}


%% read a raw sample
class CounterMetric{
    +SampleStrategies map~ITarget, ISamplerStrategy~
    +Sample(ITarget) Operation
}

%% read a raw sample, convert to a value and add units
class SampledValueMetric{
    +Sample(ITarget) Operation
}

class DeltaMetric{
    +Sample(ITarget) Operation %% interval handling omitted for diagram clarity
}

class ResidencyMetric{
    +Sample(ITarget) Operation
}

class EventMetric{
    +Sample(ITarget) Operation
}

class FiniteSetValueMetric{
    +Sample(ITarget) Operation
}

class RateMetric{
    +Sample(ITarget) Operation
}

}

SamplerOperation --|> Operation

%% any counter or metric has a set of strategies for creating operations to sample its data
%% for instance, an SoC temperature metric might have two strategies for MMIO and for SCMI.
%% Those strategies would hold the specific collector like ScmiCollector, and parameters like offsets
CounterMetric "1" *-- "*" ISamplerStrategy: owns 

%% inheritance hierarchy for metrics
CounterMetric <|-- SampledValueMetric 
CounterMetric <|-- DeltaMetric
CounterMetric <|-- ResidencyMetric
CounterMetric <|-- EventMetric
SampledValueMetric <|-- FiniteSetValueMetric 
DeltaMetric <|-- RateMetric

MetricManager ..|> IMetricManager 
IMetricManager --> CollectionOperations


%% Collector Manager and friends
%% https://jira.arm.com/browse/ASTL-36
%% https://jira.arm.com/browse/ASTL-46
%% https://jira.arm.com/browse/ASTL-47
%% https://jira.arm.com/browse/ASTL-48
%% Group 4: Collector subsystem
namespace Collector{

  %% Abstract interface for CollectorManager
  class ICollectorManager{
    <<Interface>>
    +ReportCollectionCapabilities() map~ITarget, vector[CollectorCapability]>~
    +RegisterRawSampleSink(IRawSampleSink)
    +UnregisterRawSampleSink(IRawSampleSink)
    +ConfigureCollection(ITarget, astl_collection_parameters, CollectionOperations)
    %% if a collection is configured on the given target, get the Operations from that CollectionConfiguration to run, and execute them
    +Start(ITarget)
    +Pause(ITarget)
    +Resume(ITarget)
    +Stop(ITarget)
    +ReadImmediate(ITarget)
  }

  class CollectionConfiguration{
    %% mermaid markdown doesn't support nested generics with a comma,
    %% but a collection on a target can support collecting either on counters or metrics,
    %% but not both, per API docstring.
    +_target ITarget
    +_collector ICollector
    +_state CollectionState
    +_operations CollectionOperations
    +_collection_params astl_collection_parameters_t
    +Start()
    +Pause() 
    +Resume()
    +Stop()
  }

  class CollectorManager{
    %% Members
    +_registered_raw_sample_sinks vector~IRawSampleSink~
    +_collectors map~ITarget, vector[unique_ptr[ICollector]]~
    %% Methods
    %% The TopologyManager and ConfigurationManager are responsible for creating the ICollector objects,
    %% since they know what is available and configured on the system
    +CollectorManager(map~ITarget, vector[unique_ptr[ICollector]]~)
  }

  class CollectionState{
      <<Enumeration>>
      +Stopped
      +Started
      +Paused
  }

  class ICollector{
      <<Interface>>
  }
}

%% CollectorManager implements the ICollectorManager and IRawSampleSink interfaces
ICollectorManager <|.. CollectorManager
IRawSampleSink <|.. CollectorManager
CollectorManager "1" *-- "*" CollectionConfiguration
CollectorManager "1" --> "*" IRawSampleSink: registers
%% The collector manages the lifetimes of the ICollector objects,
%% but these ICollectors aren't used for much in this context. Their concrete implementations are referenced by
%% specific counters/metrics.
CollectorManager *-- "*" ICollector: owns
CollectionConfiguration *-- CollectionState
CollectionConfiguration *-- CollectionOperations


