%% Group 1: Public API object/value types (targets, counters, metrics)
namespace AstlApiObjects{

    %% target
    class ITarget{
        <<Interface>>
        +GetParent() ITarget
        +Name() string
        +Description() string
    }

    %% counters and values
    class CounterSample {
        +CounterHandle ICounter
        +TargetHandle ITarget
        +Timestamp uint64_t
        +Value astl_value_t
    }
    
    class astl_value_type_t{
        <<Enumeration>>
        +ASTL_VALUE_UINT8
        +ASTL_VALUE_UINT16
        +ASTL_VALUE_UINT32
        +ASTL_VALUE_UINT64
        +ASTL_VALUE_FLOAT32
        +ASTL_VALUE_FLOAT64
        +ASTL_VALUE_BOOL8
        +ASTL_VALUE_UNKNOWN
    }

    class astl_value_t {
        <<Union>>
        +ui8 uint8_t
        +ui16 uint16_t
        +ui32 uint32_t
        +ui64 uint64_t
        +fp32 float
        +fp64 double
        +b8 bool
    }

    class astl_units_t {
        <<Enumeration>>
        +ASTL_UNIT_NONE
        +ASTL_UNIT_MBYTESPERSEC
        +ASTL_UNIT_MBYTES
        +ASTL_UNIT_JOULES
        +ASTL_UNIT_COUNT
        +ASTL_UNIT_UNKNOWN
    }

    class astl_counter_type_t {
        <<Enumeration>>
        +ASTL_COUNTER_TYPE_VALUE
        +ASTL_COUNTER_TYPE_COUNT
        +ASTL_COUNTER_TYPE_EVENT
        +ASTL_COUNTER_TYPE_UNKNOWN
    }

    class CounterProperties {
        +CounterHandle ICounter
        +Name string
        +Description string
        +MinSamplingInterval uint32_t
        +Units astl_units_t
        +Mask uint64_t
        +Formula string
        +ValueType astl_value_type_t
        +CounterType astl_counter_type_t
    }

    class ICounter {
        <<Interface>>
        +GetProperties() CounterProperties
        +GetSample() CounterSample
    }

    %% metrics
    class MetricSample {
        +MetricHandle IMetric
        +TargetHandle ITarget
        +Timestamp uint64_t
        +Value astl_value_t
    }

    class MetricType {
        <<Enumeration>>
        +ASTL_METRIC_VALUE
        +ASTL_METRIC_FINITE_SET_VALUE
        +ASTL_METRIC_EVENT
        +ASTL_METRIC_DELTA
        +ASTL_METRIC_RESIDENCY
        +ASTL_METRIC_RATE
        +ASTL_METRIC_UNKNOWN
    }

    class MetricProperties {
        +Handle IMetric
        +Name string
        +Description string
        +MinSamplingInterval uint32_t
        +Units astl_units_t
        +ValueType astl_value_type_t
        +MetricType astl_metric_type_t
    }

    class IMetric {
        <<Interface>>
        +GetProperties() MetricProperties
        +GetSample() MetricSample
    }

    class MetricGroup {
        +Metrics vector~IMetric~
        +Name string
        +Description string
     }

}

ITarget <-- CounterSample 
ITarget <-- MetricSample 
CounterProperties *-- astl_counter_type_t
CounterProperties *-- astl_value_type_t
CounterProperties *-- astl_units_t
ICounter *-- CounterProperties
ICounter ..> CounterSample : produces
CounterSample --> ICounter
CounterSample *-- astl_value_t
%% CounterMetric implements the ICounter interface, but the diagram doesn't display that well
%% CounterMetric --() ICounter   

MetricProperties *-- MetricType
MetricProperties *-- astl_value_type_t
MetricProperties *-- astl_units_t
%%IMetric ..> MetricSample : produces
MetricSample <.. IMetric : produces
IMetric *-- MetricProperties
MetricSample *-- astl_value_t
MetricSample --> IMetric

MetricGroup o-- IMetric: contains


%% Group 2: Core orchestrator + API + sinks (center column)
namespace AstlCore{

    %% The entry point for the C API
    class ITelemetryAPI{
        <<Interface>>
        +GetTargetCount()
        +GetTargets() ITarget
        +ConfigureCollection(ITarget, ImmediateMetric)
    }

    %% Abstract interface for TopologyManager
    class ITopologyManager{
        <<Interface>>
    }

    %% Abstract interface for ConfigurationManager
    class IConfigurationManager{
        <<Interface>>
    }

    %% Orchestrator implements the ITelemetryAPI and owns the Managers
    class Orchestrator{
        +ITopologyManager topologyManager
        +IConfigurationManager configurationManager
        +ICollectorManager collectorManager
        +IMetricManager metricManager
        +IOutputManager outputManager
        +GetTargetCount()
        +GetTargets()
        +ConfigureCollection(ITarget, ImmediateMetric)
        +StartCollection(ITarget)
        +StartCollectionPaused(ITarget)
        +PauseCollection(ITarget)
        +ResumeCollection(ITarget)
        +StopCollection(ITarget)
    }

    class IOutputManager{
        <<Interface>>
    }

    class IRawSampleSink{
        <<Interface>>
        +OnRawSample(CounterSample)
    }

}
%% end namespace AstlCore


%% Orchestrator implements the ITelemetryAPI interface, essentially the entry points of the C API
Orchestrator ..|> ITelemetryAPI 
Orchestrator ..|> IRawSampleSink 

%% Orchestrator has a composition relationship with several managers
ITopologyManager <--* Orchestrator 
IConfigurationManager <--* Orchestrator 
ICollectorManager <--* Orchestrator 
IMetricManager <--* Orchestrator 
IOutputManager <--* Orchestrator 


