sequenceDiagram
    %% Participants reflect concrete / interface names in codebase
    participant User
    participant Orchestrator
    participant MetricManager
    participant Metric1 as IMetric<<SampledValueMetric>>
    participant Metric2 as IMetric<<FiniteSetMetric>>

    %% Construction
    User->>Orchestrator: Orchestrator()
    Orchestrator->>MetricManager: MetricManager(capabilities)

    %% Register first metric configuration
    Orchestrator->>MetricManager: RegisterMetric(metric_config_1, targets)
    MetricManager->>MetricManager: Capability check (Capabilities)
    MetricManager->>Metric1: construct concrete metric
    MetricManager->>MetricManager: store MetricHandle{config, target_to_metric_map}

    %% Register second metric configuration (FiniteSetMetric example)
    Orchestrator->>MetricManager: RegisterMetric(metric_config_2, targets)
    MetricManager->>MetricManager: Capability check
    MetricManager->>Metric2: construct concrete metric
    MetricManager->>MetricManager: store MetricHandle

    %% Enumeration from public API call (astlGetMetrics -> GetAvailableMetrics)
    User->>Orchestrator: astlGetMetrics(get_metrics_params)
    Orchestrator->>MetricManager: GetAvailableMetrics()
    MetricManager-->>Orchestrator: span<astl_metric_handle_t>
    Orchestrator-->>User: metric handles

    %% Build required operations for a target prior to collection
    User->>Orchestrator: astlConfigureMetricCollectionOnTarget(configure_metric_params)
    Orchestrator->>MetricManager: GetRequiredOperations(metrics, target)
    MetricManager-->>Orchestrator: CollectionOperations
    Orchestrator->>Orchestrator: configure collectors (CollectorManager)

    %% Collection lifecycle (simplified)
    User->>Orchestrator: astlStartCollectionOnTarget(start_params)
    Orchestrator->>CollectorManager: Start(target)
    User->>Orchestrator: astlReadImmediateOnTarget(immediate_params)
    Orchestrator->>CollectorManager: ReadImmediate(target)
    CollectorManager->>MetricManager: SinkProcessedSamples(metric, processed)
    MetricManager->>Metric1: ReceiveRawSample / Summarize (as needed)
    MetricManager->>Metric2: ReceiveRawSample / Summarize (as needed)
    User->>Orchestrator: astlStopCollectionOnTarget(stop_params)
    Orchestrator->>CollectorManager: Stop(target)

    %% Destruction
    Orchestrator->>MetricManager: ~MetricManager()
    MetricManager->>Metric1: destructor
    MetricManager->>Metric2: destructor

