%% System Phase: Interval Collection & Immediate Read
%% Focus: start, paused start, sampling loop, immediate read, pause/resume
sequenceDiagram
    autonumber
    participant User
    participant API as C_API
    participant Orchestrator
    participant CollectorManager as CollectorManager
    participant MetricManager as MetricManager
    participant Collectors

    User->>API: astlStartCollectionOnTarget(start_params)
    API->>Orchestrator: StartCollectionOnTarget(target)
    Orchestrator->>CollectorManager: StartOnTarget()
    CollectorManager-->>Orchestrator: status
    Orchestrator-->>API: status

    opt Start directly into paused state
        User->>API: astlStartCollectionOnTargetPaused(start_paused_params)
        API->>Orchestrator: StartCollectionPaused(target)
        Orchestrator->>CollectorManager: StartOnTarget()
        CollectorManager-->>Orchestrator: status
        Orchestrator->>CollectorManager: PauseOnTarget()
        CollectorManager-->>Orchestrator: status
        Orchestrator-->>API: state = PAUSED
    end

    loop Sampling interval
    Collectors-->>CollectorManager: RawSampledData[]
    CollectorManager->>Orchestrator: SinkRawSamples()
        Orchestrator->>Orchestrator: buffer raw samples
    end

    alt Immediate read
        User->>API: astlReadImmediateOnTarget(immediate_params)
        API->>Orchestrator: ReadImmediateOnTarget(target)
    Orchestrator->>CollectorManager: ReadImmediateOnTarget(target)
    CollectorManager-->>Orchestrator: RawSampledData[]
        Orchestrator->>Orchestrator: buffer raw samples
    end

    opt Pause/Resume (planned)
        Note over User,Collectors: Pause/Resume functionality<br/>scheduled for future implementation<br/>(currently returns NOT_IMPLEMENTED)
        User->>API: astlPauseCollectionOnTarget(pause_params)
        API-->>User: ASTL_STATUS_NOT_IMPLEMENTED
        
        User->>API: astlResumeCollectionOnTarget(resume_params)
        API-->>User: ASTL_STATUS_NOT_IMPLEMENTED
    end
