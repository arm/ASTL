{
  "_comment": "ASTL configuration file - view README.md for more details",
  "scmi_sysfs_telemetry_root_path": "/tmp/fuse/arm_telemetry",

  "metrics": {
    "SoC Temperature": {
      "description": "SoC Temperature in Celsius",
      "register": "CORE_TEMP_0",
      "unit": "C",
      "metric_type": "value",
      "category": "TEMPERATURE",
      "metric_groups": ["thermal", "throttling"],
      "collection_protocol": "scmi"
    },
    "Throttle Counts": {
      "description": "Number of thermal throttling events",
      "register": "THROTTLE_EVENTS",
      "unit": "",
      "metric_type": "delta",
      "category": "COUNT",
      "metric_groups": ["throttling"],
      "collection_protocol": "scmi"
    },
    "SoC Power": {
      "description": "SoC Power Consumption in Watts",
      "register": "ENERGY_COUNTER",
      "unit": "W",
      "metric_type": "rate",
      "category": "POWER",
      "collection_protocol": "scmi"
    },
    "Frequency": {
      "description": "Current Frequency of the SoC in MHz",
      "register": "FREQUENCY",
      "unit": "MHz",
      "metric_type": "value",
      "category": "FREQUENCY",
      "metric_groups": ["throttling"],
      "collection_protocol": "scmi"
    }
  },

  "scmi_specification_path": "./samples/sample_topology/example_scmi_specification.json"
}
