{
  "_comment": "ASTL configuration file for libsensors, for astra2 - view README.md for more details",

  "metrics": {
    "SoC Temperature": {
      "description": "SoC Temperature in Celsius",
      "register": "apm_xgene-isa-0000",
      "offset": "temp1",
      "unit": "C",
      "metric_type": "value",
      "collection_protocol": "libsensors"
    },
    "CPU Power": {
      "description": "CPU Power Consumption in Watts",
      "register": "apm_xgene-isa-0000",
      "offset": "power1",
      "unit": "W",
      "metric_type": "value",
      "collection_protocol": "libsensors"
    },
    "IO Power": {
      "description": "IO Power Consumption in Watts",
      "register": "apm_xgene-isa-0000",
      "offset": "power2",
      "unit": "W",
      "metric_type": "value",
      "collection_protocol": "libsensors"
    }
  }
}
