{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_COVERAGE": "OFF",
        "ENABLE_VALGRIND": "OFF",
        "JSON_DIAGNOSTICS": "1"
      },
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug-coverage",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_COVERAGE": "ON",
        "ENABLE_VALGRIND": "OFF",
        "JSON_DIAGNOSTICS": "1"
      }
    },
    {
      "name": "debug-valgrind",
      "inherits": "debug",
      "cacheVariables": {
        "ASTL_VALGRIND_TRACK_ORIGINS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_COVERAGE": "OFF",
        "ENABLE_VALGRIND": "ON",
        "JSON_DIAGNOSTICS": "1"
      }
    },
    {
      "name": "debug-asan-ubsan",
      "inherits": "debug",
      "cacheVariables": {
        "ASTL_BUILD_SAMPLES": "OFF",
        "ASTL_LIBSENSORS": "ON",
        "ASTL_PROCFS": "OFF",
        "ASTL_SANITIZER": "address-undefined",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_COVERAGE": "OFF",
        "ENABLE_VALGRIND": "OFF",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      }
    },
    {
      "name": "debug-tsan",
      "inherits": "debug-asan-ubsan",
      "cacheVariables": {
        "ASTL_SANITIZER": "thread"
      }
    },
    {
      "name": "fuzz",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "ASTL_BUILD_FUZZING": "ON",
        "ASTL_BUILD_SHARED": "ON",
        "ASTL_BUILD_SAMPLES": "OFF",
        "ASTL_BUILD_TESTING": "OFF",
        "ASTL_BUILD_TOOLS": "OFF",
        "ASTL_LIBSENSORS": "OFF",
        "ASTL_PROCFS": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_COVERAGE": "OFF",
        "ENABLE_VALGRIND": "OFF"
      }
    },
    {
      "name": "debug-make",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_COVERAGE": "OFF",
        "ENABLE_VALGRIND": "OFF",
        "JSON_DIAGNOSTICS": "1"
      },
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_COVERAGE": "OFF",
        "ENABLE_VALGRIND": "OFF"
      },
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "release-static",
      "inherits": "release",
      "cacheVariables": {
        "ATX_STATIC_LINK": "ON"
      },
      "binaryDir": "${sourceDir}/build/release-static"
    },
    {
      "name": "windows-release",
      "inherits": "release",
      "generator": "Ninja"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "debug-coverage",
      "configurePreset": "debug-coverage",
      "configuration": "Debug"
    },
    {
      "name": "debug-valgrind",
      "configurePreset": "debug-valgrind",
      "configuration": "Debug"
    },
    {
      "name": "debug-asan-ubsan",
      "configurePreset": "debug-asan-ubsan",
      "configuration": "Debug"
    },
    {
      "name": "debug-tsan",
      "configurePreset": "debug-tsan",
      "configuration": "Debug"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "configuration": "Debug"
    },
    {
      "name": "debug-make",
      "configurePreset": "debug-make",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "release-static",
      "configurePreset": "release-static",
      "configuration": "Release"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-coverage",
      "configurePreset": "debug-coverage",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-valgrind",
      "configurePreset": "debug-valgrind",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-asan-ubsan",
      "configurePreset": "debug-asan-ubsan",
      "configuration": "Debug",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:abort_on_error=1:strict_string_checks=1:check_initialization_order=1:symbolize=1:log_path=${sourceDir}/build/debug-asan-ubsan/sanitizer-logs/asan",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1:log_path=${sourceDir}/build/debug-asan-ubsan/sanitizer-logs/ubsan"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-tsan",
      "configurePreset": "debug-tsan",
      "configuration": "Debug",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:symbolize=1:log_path=${sourceDir}/build/debug-tsan/sanitizer-logs/tsan"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-make",
      "configurePreset": "debug-make",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
